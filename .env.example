# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to version control.

# Port the Express server will run on
PORT=3000

# Path to the SQLite database file (it will be created automatically)
DATABASE_FILE=./database/visalatchi.db

# Secret key used to sign admin login tokens (JWT).
# Use a long, random, unique string in production.
JWT_SECRET=change_this_to_a_long_random_secret_key

# Default admin account created the first time the server starts
# (only used if no admin exists yet in the database)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_password

# Maximum uploaded image size in bytes (default 2 MB)
MAX_IMAGE_SIZE=2097152
